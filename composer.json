{
    "name": "emleons/sim-rating",
    "description": "A secure, framework-agnostic 5-star rating rendering library for PHP.",
    "type": "library",
    "keywords": [
        "rating",
        "stars",
        "review",
        "review-score",
        "laravel",
        "codeigniter",
        "symfony",
        "php"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "emleonstz",
            "email": "emleons23@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/emleonstz/sim-rating/issues",
        "source": "https://github.com/emleonstz/sim-rating"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Emleons\\SimRating\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emleons\\SimRating\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}

